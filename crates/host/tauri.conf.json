{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NepaliToolkit",
  "version": "0.1.0",
  "identifier": "com.aaxyat.nepalitoolkit",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "NepaliToolkit",
        "width": 380,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "windowEffects": {
          "effects": ["mica"],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NepaliTools",
    "copyright": "Copyright © 2026 NepaliTools",
    "category": "Utility",
    "shortDescription": "Nepali date in your Windows tray",
    "longDescription": "A quiet tray app for Bikram Sambat: today's Nepali date, a two-way BS and AD converter, and no network.",
    "homepage": "https://nepalitools.pages.dev",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "startMenuFolder": "NepaliTools",
        "languages": ["English"],
        "compression": "lzma"
      }
    }
  }
}
